# Database
DB_NAME=agent
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_ADMIN_DB=postgres

# LLM - Primary
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# LLM - Fallback (for rate limiting)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# auto = Groq first, OpenRouter on failure. groq / openrouter pin one provider.
LLM_PROVIDER=auto
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY=2.0

# API authentication (both are required; there is no development bypass)
API_KEY=your_customer_api_key
ADMIN_API_KEY=your_admin_api_key
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000

# Rate Limiting (process-local; use Redis for multi-replica deployments)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Retrieval / embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.0
MAX_CONTEXT_CHUNKS=5
CHUNK_SIZE=200
CHUNK_OVERLAP=30
CONVERSATION_HISTORY_LIMIT=20

# App
ENVIRONMENT=production
RUN_MIGRATIONS_ON_STARTUP=true
